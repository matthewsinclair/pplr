# Cargo's build tree, and devbin's logs and scratch
/target/
/tmp/
# The macOS signer's staging and release assets (bin/.devbin/cmd/macos)
/dist/

# macOS and editor droppings
.DS_Store
# Finder custom-icon files: "Icon" and a carriage return, written with two CRs because git strips one
Icon
.obsidian

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# Intent's store snapshots and text exports: per-machine, never committed.
intent/.backup/
