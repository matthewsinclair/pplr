#!/bin/bash

# USAGE: Compare pplr with Apple Contacts, and link matched cards to pplr
# USAGE: --check          report linked, matched, missing and differing people
# USAGE: --link           mark matched cards as pplr's (a dry run without --apply)
# USAGE: --plan           write a review workbook: pplr, Contacts, and a proposed merge
# USAGE: --apply-plan FILE  write the reviewed plan workbook to Contacts (a dry run without --apply)
# USAGE: --photos         give linked cards with no photo their pplr picture (a dry run without --apply)
# USAGE: --backup         save every Contacts card to a dated .vcf in $PPLR_BACKUP_DIR
# USAGE: [--apply]        with --link: write, after a .vcf backup of every card
# USAGE: [--name NAME]    with --link: also link this name-only match ("Surname, First"; repeatable)
# USAGE: [--limit N]      with --link --apply: write only the first N (to try it on one card)
# USAGE: [--all-names]    with --link: also link every name-only match
# USAGE: [--json]         the report as JSON
# USAGE: [-v|--verbose]   also list everyone only in pplr
# USAGE: [--out FILE]     with --plan: the workbook to write (default $PPLR_DATA/_out/contacts-plan-<stamp>.xlsx)
# USAGE: [--group NAME]   the Contacts group that marks pplr people (default PPLR)

# Set up environment variables
: "${PPLR_DATA:=$HOME/Dropbox/Career/People}"
: "${PPLR_DIR:=$PPLR_DATA}"
: "${PPLR_BACKUP_DIR:=$HOME/Library/Application Support/pplr/contacts-backups}"
: "${PPLR_ROOT:=$(dirname "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")")}"

# shellcheck source=../lib/engine.sh
source "$PPLR_ROOT/lib/engine.sh"

usage() {
  echo "Usage: pplr sync --check [--json] [-v|--verbose] [--group NAME]"
  echo "       pplr sync --plan [--out FILE] [--json] [--group NAME]"
  echo "       pplr sync --apply-plan WORKBOOK [--apply] [--limit N] [--name \"Surname, First\"]..."
  echo "       pplr sync --photos [--apply] [--limit N]"
  echo "       pplr sync --backup"
  echo "       pplr sync --link [--apply] [--name \"Surname, First\"]... [--all-names] [--group NAME]"
  echo "  --check         Compare pplr with Apple Contacts; changes nothing"
  echo "  --link          Mark matched cards as pplr's: the pplr URL and the group, nothing else"
  echo "  --plan          Write a workbook for review: pplr, Contacts, and a proposed merge; changes nothing"
  echo "  --apply-plan F  Carry out a reviewed --plan workbook: Add, Update, Link only (a dry run without --apply)"
  echo "  --photos        Give linked cards with no photo the pplr picture (a dry run without --apply)"
  echo "  --backup        Save every Contacts card to a dated .vcf in \$PPLR_BACKUP_DIR"
  echo "  --apply         With --link, write (a dry run otherwise); every card is saved to a .vcf first"
  echo "  --name NAME     With --link, also link this name-only match (repeatable)"
  echo "  --limit N       With --link --apply, write only the first N"
  echo "  --all-names     With --link, also link every name-only match"
  echo "  --out FILE      With --plan, the workbook to write (default: \$PPLR_DATA/_out/contacts-plan-<stamp>.xlsx)"
  echo "  --json          Print the report (or with --plan, the plan) as JSON"
  echo "  -v, --verbose   Also list everyone who is only in pplr"
  echo "  --group NAME    The Contacts group that marks pplr people (default: PPLR)"
}

mode=""
out=""
workbook=""
pass=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --check) mode="check"; shift ;;
    --link) mode="link"; shift ;;
    --backup) mode="backup"; shift ;;
    --plan) mode="plan"; shift ;;
    --photos) mode="photos"; shift ;;
    --apply-plan) mode="applyplan"; workbook="$2"; shift 2 ;;
    --out) out="$2"; shift 2 ;;
    --apply) pass+=(--apply); shift ;;
    --name) pass+=(--name "$2"); shift 2 ;;
    --all-names) pass+=(--all-names); shift ;;
    --limit) pass+=(--limit "$2"); shift 2 ;;
    --json) pass+=(--json); shift ;;
    -v|--verbose) pass+=(--verbose); shift ;;
    --group) pass+=(--group "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Error: unknown option '$1'"; usage; exit 1 ;;
  esac
done

if [ -z "$mode" ]; then
  usage
  exit 1
fi

# Tests point the engine at a fixture instead of the live Contacts store
if [ -n "$PPLR_CONTACTS_JSON" ]; then
  pass+=(--contacts-json "$PPLR_CONTACTS_JSON")
fi

if [ "$mode" = "link" ] || [ "$mode" = "backup" ] || [ "$mode" = "applyplan" ] || [ "$mode" = "photos" ]; then
  pass+=(--backup-dir "$PPLR_BACKUP_DIR")
fi

build_engine

# The plan: the engine's JSON, rendered as a workbook unless --json
if [ "$mode" = "plan" ]; then
  if [[ " ${pass[*]} " == *" --json "* ]]; then
    json_free=()
    for a in "${pass[@]}"; do [ "$a" = "--json" ] || json_free+=("$a"); done
    "$engine" plan --people-dir "$PPLR_DIR" "${json_free[@]}"
    exit $?
  fi
  command -v uv >/dev/null 2>&1 || { echo "Error: uv not found (it runs the workbook step with openpyxl). Install it: brew install uv"; exit 1; }
  [ -n "$out" ] || out="$PPLR_DATA/_out/contacts-plan-$(date +%Y%m%d-%H%M).xlsx"
  mkdir -p "$(dirname "$out")"
  plan_json=$(mktemp -t pplr-plan)
  trap 'rm -f "$plan_json"' EXIT
  "$engine" plan --people-dir "$PPLR_DIR" "${pass[@]}" > "$plan_json" || exit 1
  uv run --quiet --with openpyxl python3 "$PPLR_ROOT/src/pplr-contacts/workbook.py" "$plan_json" "$out" || exit 1
  echo "pplr sync --plan (read-only)"
  echo ""
  jq -r '.rows | sort_by({"Low": 0, "Medium": 1, "High": 2}[.confidence]) | group_by(.confidence + " / " + .decision)
         | sort_by({"Low": 0, "Medium": 1, "High": 2}[.[0].confidence]) | .[] | "  \(length)\t\(.[0].confidence) / \(.[0].decision)"' "$plan_json"
  echo ""
  echo "Workbook: $out"
  exit 0
fi

# A reviewed plan: its decisions read from the workbook, then carried out by the engine
if [ "$mode" = "applyplan" ]; then
  [[ "$workbook" = /* ]] || workbook="${PPLR_CALLER_DIR:-$PWD}/$workbook"
  [ -f "$workbook" ] || { echo "Error: no such workbook: $workbook"; exit 1; }
  command -v uv >/dev/null 2>&1 || { echo "Error: uv not found (it reads the workbook with openpyxl). Install it: brew install uv"; exit 1; }
  decisions=$(mktemp -t pplr-decisions)
  trap 'rm -f "$decisions"' EXIT
  uv run --quiet --with openpyxl python3 "$PPLR_ROOT/src/pplr-contacts/workbook.py" --decisions "$workbook" "$decisions" || exit 1
  "$engine" applyplan --people-dir "$PPLR_DIR" --decisions "$decisions" "${pass[@]}"
  exit $?
fi

"$engine" "$mode" --people-dir "$PPLR_DIR" "${pass[@]}"
