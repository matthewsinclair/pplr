#!/usr/bin/env zsh
# devbin: summary = cargo build, then the Contacts sidecar beside the binary on macOS
# devbin: group = Build
#
# Build pplr, and on macOS its Contacts sidecar beside it, ahead of time
# (ST0001 design D2 and 3.2): nothing compiles at run time. Arguments go to
# cargo build, eg --release; the sidecar lands in the same target/<profile>/.

emulate -L zsh
setopt err_exit no_unset pipe_fail

root=${0:A:h:h:h:h}
cd $root
cargo build --quiet "$@"

[[ $(uname) == Darwin ]] || { print "build: no Contacts sidecar off macOS (it needs the Contacts framework)"; exit 0 }
profile=debug
(( ${@[(Ie)--release]} )) && profile=release
src=swift/pplr-contacts/main.swift
# Its Info.plist is linked in, so macOS can name it and show the Contacts prompt
plist=swift/pplr-contacts/Info.plist
out=target/$profile/pplr-contacts
if [[ ! -x $out || $src -nt $out || $plist -nt $out ]]; then
  print "build: compiling the Contacts sidecar into $out"
  swiftc -O -swift-version 5 -o $out $src -framework Contacts \
    -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker $plist
fi

# The pplr:// handler app, beside the binary (ST0001 WP08; hv's ruling: built
# ahead of time and signed, never on the user's machine)
app_src="packaging/macos/Pplr Links.applescript"
app="target/$profile/Pplr Links.app"
if [[ ! -d $app || $app_src -nt $app ]]; then
  print "build: compiling the pplr:// handler into $app"
  rm -rf $app
  osacompile -o $app $app_src
  plist=$app/Contents/Info.plist
  pb() { /usr/libexec/PlistBuddy -c "$1" $plist }
  pb "Set :CFBundleIdentifier com.geodica.pplr-links" 2>/dev/null || pb "Add :CFBundleIdentifier string com.geodica.pplr-links"
  pb "Add :LSUIElement bool true"
  pb "Add :CFBundleURLTypes array"
  pb "Add :CFBundleURLTypes:0 dict"
  pb "Add :CFBundleURLTypes:0:CFBundleURLName string pplr link"
  pb "Add :CFBundleURLTypes:0:CFBundleURLSchemes array"
  pb "Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string pplr"
  # The plist edits break osacompile's signature: sign it ad hoc again, as the
  # dev build it is (the release signs it with the Developer ID)
  codesign --force --sign - $app
fi
