#!/usr/bin/env zsh
# devbin: summary = devbin's T10 proof for pplr: publish opt, then use dev, opt and brew in turn, moving ~/.local/bin/pplr (ST0002 WP05)
# devbin: group = Ship
#
# bin/devbin t10-probe: devbin's T10 proof for pplr (ST0002 WP05), through
# devbin's own publish and switch (devbin#0326, pplr#0001), run in pplr's
# checkout.
#
#   bin/devbin t10-probe
#
# `bin/devbin build`, then `bin/devbin install --force` to the install:
# block's prefix. Then, for dev, opt and brew in turn, `bin/devbin use <tree>`,
# with pplr --version naming that tree and `bin/devbin doctor` passing, its
# shadow check and version-line check included. It PUBLISHES the opt tree and
# MOVES ~/.local/bin/pplr, so on the maintainer's machine it changes which
# pplr answers. It ends on brew, where the switch rests. Each step's verdict is
# printed, and it exits non-zero if any failed. The brew leg reads `(brew, `
# only once a release carrying this pplr is installed by Homebrew.

emulate -L zsh
setopt no_unset pipe_fail

export HOMEBREW_NO_AUTO_UPDATE=1
root=${0:A:h:h:h:h}
cd $root

failed=0
probe() {
  local what=$1; shift
  if "$@"; then print "  ok    $what"; else print "  FAIL  $what"; failed=1; fi
}

print -r -- "== publish"
probe "bin/devbin build" bin/devbin build
probe "bin/devbin install --force" bin/devbin install --force

for tree in dev opt brew; do
  print -r -- "== use $tree"
  probe "use $tree" bin/devbin use $tree
  rehash
  # The link (or, after use brew, Homebrew's) is what answers now
  probe "version line names $tree" eval '[[ "$(command pplr --version)" == "pplr "*" ($tree, "* ]]'
  print -r -- "  $(command pplr --version)"
  probe "bin/devbin doctor" bin/devbin doctor
done
exit $failed
