#!/bin/bash

# USAGE: (re)create the indexes in $PPLR_DIR/.index, the tag pages and each About's Tags line

# Default location of PPLR_DIR if not already set
: "${PPLR_DATA:=$HOME/Dropbox/Career/People}"
: "${PPLR_DIR:=$PPLR_DATA}"
: "${PPLR_ROOT:=$(dirname "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")")}"
: "${PPLR_BIN_DIR:=$PPLR_ROOT/bin}"
: "${PPLR_TEMPLATE_DIR:=$PPLR_ROOT/templates}"

case "$1" in
  --tags|--stale-only|--max-age=*)
    # The Claude tagger that wrote .index/tags.json per person is retired:
    # tags now live in each About/tags.yaml, against _pplr/vocabulary.yaml
    echo "pplr reindex --tags is retired. Tags live in each person's About/tags.yaml:"
    echo "  pplr tag \"Surname, First\" +tag -tag   edit one person's tags"
    echo "  pplr tags check                        check everyone against the vocabulary"
    echo "  pplr reindex                           rebuild indexes, tag pages and Tags lines"
    exit 1 ;;
  -h|--help)
    echo "Usage: pplr reindex"
    echo "  .index/index.json, .index/index.md, .index/tags_index.json, the tag pages"
    echo "  in _tags/, and the Tags line in each About (from each About/tags.yaml)"
    exit 0 ;;
esac

CURRENT_DIR=$(pwd)
cd "$PPLR_DIR" || exit 1
mkdir -p .index

echo "Generating: $PPLR_DIR/.index/index.json"
"$PPLR_BIN_DIR/pplr_json" | jq . > .index/index.json

echo "Generating: $PPLR_DIR/.index/index.md"
"$PPLR_BIN_DIR/pplr_index" > .index/index.md

echo "Generating: $PPLR_DIR/.index/tags_index.json, $PPLR_DIR/_tags/ and each About's Tags line"
"$PPLR_BIN_DIR/pplr_tags" render

cd "$CURRENT_DIR" || exit 0
