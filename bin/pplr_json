#!/bin/bash

# USAGE: generate index.json based on contents of $PPLR_DIR


# Script name: people_json
# Description: Generate a JSON file listing all people from the directory structure, ignoring specific directories.

# Default location of PPLR_DIR if not already set
: "${PPLR_DATA:=$HOME/Dropbox/Career/People}"
: "${PPLR_DIR:=$PPLR_DATA}"
: "${PPLR_ROOT:=$(dirname "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")")}"
: "${PPLR_BIN_DIR:=$PPLR_ROOT/bin}"
: "${PPLR_TEMPLATE_DIR:=$PPLR_ROOT/templates}"


# Define the base directory (set to the current directory for execution within "People/")
BASE_DIR="."

# Regular expression for directories and files to ignore
IGNORE_DIRS="^_Templates$|^bin$|^\.index$"

echo '{ "people": {'

# Loop through each letter directory under the current directory
first_letter=true
for letter_dir in "$BASE_DIR"/*; do
    letter=$(basename "$letter_dir")

    # Check if the directory should be ignored
    if [[ $letter =~ $IGNORE_DIRS ]]; then
        continue
    fi

    if [[ -d "$letter_dir" ]]; then
        if [ "$first_letter" != true ]; then
            echo ','
        fi
        first_letter=false

        echo "\"$letter\": ["

        first_person=true
        for person_dir in "$letter_dir"/*; do
            if [[ -d "$person_dir" ]]; then
                if [ "$first_person" != true ]; then
                    echo ','
                fi
                first_person=false

                person_name=$(basename "$person_dir")

                # Person dirs are "Surname, Firstname" but the files inside About/
                # are named "Firstname Surname (...)". Derive the file stem the same
                # way pplr_index does, rather than reusing the directory name.
                # Split on the comma only. Using IFS=', ' also splits on spaces,
                # which mangles multi-word surnames ("de Vries, Anna",
                # "van Dijk, Pieter", "Ap Rhys, Owen").
                surname="${person_name%%,*}"
                firstname="${person_name#*, }"
                file_stem="$firstname $surname"

                about_file="$person_dir/About/${file_stem} (About).md"
                linkedin_file="$person_dir/About/${file_stem} (LinkedIn).webloc"
                profile_file="$person_dir/About/${file_stem} (Profile).pdf"

                # Pictures are mostly .jpg but sometimes .png, so probe rather
                # than assuming a single extension.
                picture_file=""
                for ext in jpg png jpeg; do
                    if [ -f "$person_dir/About/${file_stem} (Picture).$ext" ]; then
                        picture_file="$person_dir/About/${file_stem} (Picture).$ext"
                        break
                    fi
                done
                if [ -z "$picture_file" ]; then
                    picture_file="$person_dir/About/${file_stem} (Picture).jpg"
                fi

                # Emit person entry
                echo -n "{ \"name\": \"$person_name\", \"about\": {"
                echo -n "\"about\": \"$about_file\", "
                echo -n "\"linkedin\": \"$linkedin_file\", "
                echo -n "\"picture\": \"$picture_file\", "
                echo "\"profile\": \"$profile_file\" }, \"meetings\": ["

                # Handle meetings
                first_meeting=true
                for meeting_dir in "$person_dir/Meetings"/*; do
                    # Skip housekeeping dirs such as _Archive; they are not meetings.
                    case "$(basename "$meeting_dir")" in _*) continue ;; esac
                    if [ -d "$meeting_dir" ]; then
                        if [ "$first_meeting" != true ]; then
                            echo ','
                        fi
                        first_meeting=false

                        meeting_id=$(basename "$meeting_dir")

                        # Older meetings keep their notes in "<meeting id>.md";
                        # newer ones split into Summary.md and Notes.md. Prefer
                        # the legacy single file, then Summary, then Notes.
                        if [ -f "$meeting_dir/${meeting_id}.md" ]; then
                            meeting_details="$meeting_dir/${meeting_id}.md"
                        elif [ -f "$meeting_dir/Summary.md" ]; then
                            meeting_details="$meeting_dir/Summary.md"
                        elif [ -f "$meeting_dir/Notes.md" ]; then
                            meeting_details="$meeting_dir/Notes.md"
                        else
                            meeting_details="$meeting_dir/${meeting_id}.md"
                        fi
                        echo -n "{ \"id\": \"$meeting_id\", \"details\": \"$meeting_details\" }"
                    fi
                done
                echo -n "] }"
            fi
        done
        echo ''
        echo ']'
    fi
done
echo '}}'
