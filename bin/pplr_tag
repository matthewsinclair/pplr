#!/bin/bash

# USAGE: show or edit one person's tags (About/tags.yaml), checked against the vocabulary
# USAGE: <"Surname, First">            show their tags, by facet
# USAGE: <"Surname, First"> +tag -tag   add or remove tags (an added tag is yours: never overwritten)

: "${PPLR_ROOT:=$(dirname "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")")}"

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: pplr tag \"Surname, First\" [+tag] [-tag]..."
  echo "  With no changes, shows their tags. Tags must be in _pplr/vocabulary.yaml."
  echo "  Run pplr reindex (or pplr tags render) afterwards to refresh the tag pages."
  exit 1
fi
person="$1"; shift
if [ $# -eq 0 ]; then exec "$PPLR_ROOT/bin/pplr_tags" show "$person"; fi
"$PPLR_ROOT/bin/pplr_tags" edit "$person" "$@" || exit $?
# a roster or cadence tag changes the cadence (Contact).md shows, so re-render them
"$PPLR_ROOT/bin/pplr_contact" render >/dev/null
