#!/usr/bin/env zsh
# Build the Rust pplr, then run the bats suite against it through the
# PPLR_UNDER_TEST seam (ST0001 design D3). Arguments go to tests/run_tests.sh.

emulate -L zsh
setopt err_exit no_unset pipe_fail

root=${0:A:h:h}
cd $root
cargo build --quiet
PPLR_UNDER_TEST=$root/target/debug/pplr exec tests/run_tests.sh "$@"
